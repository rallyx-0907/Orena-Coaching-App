  "header": {
    "title": {
      "vi": "Câu chữ 把",
      "en": "The 把 sentence"
    },
    "native_title": "把字句",
    "level": {
      "framework": "hsk3",
      "value": "3",
      "rank": 3
    },
    "summary": {
      "vi": "Câu chữ 把 dùng để nhấn mạnh việc xử lý một vật cụ thể và kết quả của việc đó, với vật bị xử lý đứng ngay sau 把.",
      "en": "把 puts the object before the verb to stress what was done to it and the result."
    },
    "sub": {
      "vi": "kết quả xử lý",
      "en": "handling an object"
    },
    "native_title_pinyin": [
      "bǎ",
      "zì",
      "jù"
    ]
  },
  "when_to_use": [
    {
      "vi": "Khi muốn nói rõ mình đã làm gì với một vật cụ thể và kết quả ra sao."
    },
    {
      "vi": "Khi vật bị xử lý là một đối tượng xác định, không phải chung chung."
    },
    {
      "vi": "Khi câu có kết quả hoặc thay đổi rõ ràng ở cuối, như 完, 好, 在, 到."
    },
    {
      "vi": "Khi muốn tránh cách nói chỉ nêu hành động mà không cho biết kết quả."
    }
  ],
