{
  "_comment": "Shared by tests/test_n8n_vocab_workflow.py (jsonschema is the truth) and scripts/test_n8n_vocab_workflow.mjs (the workflow's validator must agree). A case applies `ops` to a docs/vocab sample; `path` is a list of keys / indexes. `valid` is whether docs/vocab/vocab_entry.schema.json accepts the result.",
  "cases": [
    { "name": "en sample is valid", "sample": "en_resilient", "ops": [], "valid": true },
    { "name": "zh sample is valid", "sample": "zh_senlin", "ops": [], "valid": true },
    { "name": "extra top-level field", "sample": "en_resilient", "ops": [["set", ["foo"], "x"]], "valid": false },
    { "name": "en.etymology_en is not in the schema", "sample": "en_resilient", "ops": [["set", ["en", "etymology_en"], "from Latin"]], "valid": false },
    { "name": "CEFR value out of range", "sample": "en_resilient", "ops": [["set", ["level", "value"], "C3"]], "valid": false },
    { "name": "en with an HSK scale", "sample": "en_resilient", "ops": [["set", ["level", "scale"], "HSK3"]], "valid": false },
    { "name": "zh level 7-9", "sample": "zh_senlin", "ops": [["set", ["level", "value"], "7-9"]], "valid": true },
    { "name": "zh level 0", "sample": "zh_senlin", "ops": [["set", ["level", "value"], "0"]], "valid": false },
    { "name": "missing pos", "sample": "en_resilient", "ops": [["del", ["pos"]]], "valid": false },
    { "name": "empty pos", "sample": "en_resilient", "ops": [["set", ["pos"], []]], "valid": false },
    { "name": "unknown pos code", "sample": "en_resilient", "ops": [["set", ["pos", 0, "code"], "adjectif"]], "valid": false },
    { "name": "no examples", "sample": "en_resilient", "ops": [["set", ["examples"], []]], "valid": false },
    { "name": "empty meanings", "sample": "en_resilient", "ops": [["set", ["meanings"], []]], "valid": false },
    { "name": "meaning without vi", "sample": "en_resilient", "ops": [["del", ["meanings", 0, "vi"]]], "valid": false },
    { "name": "example without translation_vi", "sample": "en_resilient", "ops": [["del", ["examples", 0, "translation_vi"]]], "valid": false },
    { "name": "example without highlight", "sample": "en_resilient", "ops": [["del", ["examples", 0, "highlight"]]], "valid": false },
    { "name": "highlight occurrence 0", "sample": "en_resilient", "ops": [["set", ["examples", 0, "highlight", "occurrence"], 0]], "valid": false },
    { "name": "highlight occurrence 2 is schema-valid", "sample": "en_resilient", "ops": [["set", ["examples", 0, "highlight", "occurrence"], 2]], "valid": true },
    { "name": "id with capitals", "sample": "en_resilient", "ops": [["set", ["id"], "EN:Resilient"]], "valid": false },
    { "name": "id without a prefix", "sample": "en_resilient", "ops": [["set", ["id"], "resilient"]], "valid": false },
    { "name": "status archived", "sample": "en_resilient", "ops": [["set", ["status"], "archived"]], "valid": false },
    { "name": "status published is schema-valid", "sample": "en_resilient", "ops": [["set", ["status"], "published"]], "valid": true },
    { "name": "en with a zh section", "sample": "en_resilient", "ops": [["set", ["zh"], { "pinyin": "a", "chars": [{ "hanzi": "a", "pinyin": "a" }] }]], "valid": false },
    { "name": "en without the en section", "sample": "en_resilient", "ops": [["del", ["en"]]], "valid": false },
    { "name": "en ipa empty object", "sample": "en_resilient", "ops": [["set", ["en", "ipa"], {}]], "valid": false },
    { "name": "en ipa only us", "sample": "en_resilient", "ops": [["set", ["en", "ipa"], { "us": "/rɪˈzɪljənt/" }]], "valid": true },
    { "name": "zh without the zh section", "sample": "zh_senlin", "ops": [["del", ["zh"]]], "valid": false },
    { "name": "zh with an en section", "sample": "zh_senlin", "ops": [["set", ["en"], { "ipa": { "us": "/a/" } }]], "valid": false },
    { "name": "zh hanzi of two characters", "sample": "zh_senlin", "ops": [["set", ["zh", "chars", 0, "hanzi"], "森林"]], "valid": false },
    { "name": "zh strokes 0", "sample": "zh_senlin", "ops": [["set", ["zh", "chars", 0, "strokes"], 0]], "valid": false },
    { "name": "zh strokes 1.5", "sample": "zh_senlin", "ops": [["set", ["zh", "chars", 0, "strokes"], 1.5]], "valid": false },
    { "name": "zh chars empty", "sample": "zh_senlin", "ops": [["set", ["zh", "chars"], []]], "valid": false },
    { "name": "zh char pinyin empty string is schema-valid", "sample": "zh_senlin", "ops": [["set", ["zh", "chars", 0, "pinyin"], ""]], "valid": true },
    { "name": "audio with an unknown field", "sample": "en_resilient", "ops": [["set", ["audio", "src"], "x"]], "valid": false },
    { "name": "tags not strings", "sample": "en_resilient", "ops": [["set", ["tags"], [1]]], "valid": false },
    { "name": "empty headword", "sample": "en_resilient", "ops": [["set", ["headword"], ""]], "valid": false },
    { "name": "unsupported language", "sample": "en_resilient", "ops": [["set", ["lang"], "fr"]], "valid": false },
    { "name": "related with an unknown relation", "sample": "en_resilient", "ops": [["set", ["related", 0, "relation"], "cousin"]], "valid": false },
    { "name": "five examples", "sample": "en_resilient", "ops": [["set", ["examples"], "__five__"]], "valid": false },
    { "name": "illustration kind none", "sample": "en_resilient", "ops": [["set", ["illustration"], { "kind": "none" }]], "valid": true },
    { "name": "illustration kind unknown", "sample": "en_resilient", "ops": [["set", ["illustration", "kind"], "gif"]], "valid": false }
  ]
}
