      "segments": [
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:000",
          "start_ms": 16120,
          "end_ms": 22000,
          "original_text": "现在看到的是中文维基百科的首页(Vector版)",
          "pinyin": "Xiànzài kàndào de shì Zhōngwén Wéijī Bǎkē de shǒuyè (Vector bǎn)",
          "translations": {
            "en": "What you see now is the Chinese Wikipedia home page (Vector skin).",
            "vi": "Đây là trang chủ Wikipedia tiếng Trung (giao diện Vector)."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:001",
          "start_ms": 22240,
          "end_ms": 27520,
          "original_text": "你可以输入你找的内容",
          "pinyin": "Nǐ kěyǐ shūrù nǐ zhǎo de nèiróng",
          "translations": {
            "en": "You can type in what you are looking for.",
            "vi": "Bạn có thể nhập nội dung bạn đang tìm."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:002",
          "start_ms": 27800,
          "end_ms": 30960,
          "original_text": "相关条目会在下方展开",
          "pinyin": "Xiāngguān tiáomù huì zài xiàfāng zhǎnkāi",
          "translations": {
            "en": "Related articles appear below.",
            "vi": "Các mục từ liên quan sẽ hiện ra bên dưới."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:003",
          "start_ms": 31200,
          "end_ms": 36160,
          "original_text": "也可在最下方选择「包含...」来搜寻所有相关条目",
          "pinyin": "Yě kě zài zuì xiàfāng xuǎnzé 「bāohán...」 lái sōuxún suǒyǒu xiāngguān tiáomù",
          "translations": {
            "en": "You can also choose Contains at the bottom to search every related article.",
            "vi": "Bạn cũng có thể chọn Chứa ở dưới cùng để tìm mọi mục từ liên quan."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:004",
          "start_ms": 36360,
          "end_ms": 41840,
          "original_text": "按「放大镜」可以直接找你输入的条目",
          "pinyin": "Àn 「fàngdàjìng」 kěyǐ zhíjiē zhǎo nǐ shūrù de tiáomù",
          "translations": {
            "en": "Press the magnifying glass to go straight to the article you typed.",
            "vi": "Nhấn kính lúp để vào thẳng mục từ bạn đã nhập."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:005",
          "start_ms": 42120,
          "end_ms": 50440,
          "original_text": "这样，你便可以找到所需的条目了",
          "pinyin": "Zhèyàng, nǐ biàn kěyǐ zhǎdào suǒ xū de tiáomù le",
          "translations": {
            "en": "This way, you can find the article you need.",
            "vi": "Như vậy, bạn có thể tìm được mục từ mình cần."
          }
        },
        {
          "segment_id": "commons-zh-wikipedia-tutorial-1:006",
          "start_ms": 50840,
          "end_ms": 59400,
          "original_text": "另外用MonoBook 、MySkin等版本也有相同功能",
          "pinyin": "Lìngwài yòng MonoBook、MySkin děng bǎnběn yě yǒu xiāngtóng gōngnéng",
          "translations": {
            "en": "Other skins such as MonoBook and MySkin have the same feature.",
            "vi": "Ngoài ra các giao diện như MonoBook, MySkin cũng có chức năng tương tự."
          }
        }
      ]
    }
  ],
