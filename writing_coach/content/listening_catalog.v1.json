      "duration_ms": 21119,
      "playback": {
        "provider": "wikimedia-commons",
        "kind": "audio",
        "url": "https://commons.wikimedia.org/wiki/Special:Redirect/file/Chinese-Lesson1-Dialogue2.ogg"
      },
      "rights": {
        "license_name": "CC BY-SA 3.0",
