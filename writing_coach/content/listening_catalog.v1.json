      },
      "segments": [
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:000",
          "start_ms": 415,
          "end_ms": 1364,
          "original_text": "金妮：他们是谁？",
          "pinyin": "Jīnní: Tāmen shì shéi?",
          "translations": {
            "vi": "Ginny: Họ là ai?",
            "en": "Ginny: Who are they?"
          },
          "spoken_text": "他们是谁？"
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:001",
          "start_ms": 2864,
          "end_ms": 7924,
          "original_text": "欧文：她是艾美，她是中国人。他是东尼，他是美国人。",
          "pinyin": "Ōuwén: Tā shì Àiměi, tā shì Zhōngguórén. Tā shì Dōngní, tā shì Měiguórén.",
          "translations": {
            "vi": "Owen: Cô ấy là Amy, người Trung Quốc. Anh ấy là Tony, người Mỹ.",
            "en": "Owen: She is Amy, and she is Chinese. He is Tony, and he is American."
          },
          "spoken_text": "她是艾美，她是中国人。他是东尼，他是美国人。"
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:002",
          "start_ms": 10018,
          "end_ms": 11627,
          "original_text": "金妮：你也是美国人吗？",
          "pinyin": "Jīnní: Nǐ yě shì Měiguórén ma?",
          "translations": {
            "vi": "Ginny: Bạn cũng là người Mỹ à?",
            "en": "Ginny: Are you also American?"
          },
          "spoken_text": "你也是美国人吗？"
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:003",
          "start_ms": 12994,
          "end_ms": 18115,
          "original_text": "欧文：不是，我是英国人。你呢？你是哪国人？",
          "pinyin": "Ōuwén: Bú shì, wǒ shì Yīngguórén. Nǐ ne? Nǐ shì nǎ guó rén?",
          "translations": {
            "vi": "Owen: Không, tôi là người Anh. Còn bạn? Bạn là người nước nào?",
            "en": "Owen: No, I'm British. How about you? What nationality are you?"
          },
          "spoken_text": "不是，我是英国人。你呢？你是哪国人？"
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:004",
          "start_ms": 19661,
          "end_ms": 20637,
          "original_text": "金妮：我是法国人。",
          "pinyin": "Jīnní: Wǒ shì Fǎguórén.",
          "translations": {
            "vi": "Ginny: Tôi là người Pháp.",
            "en": "Ginny: I'm French."
          },
          "spoken_text": "我是法国人。"
        }
      ]
    },
    {
      "source_media_id": "commons-royalsociety-cosmic-calendar",
      "source_url": "https://commons.wikimedia.org/wiki/File:Deep_time_and_cosmic_history_as_one_year_%E2%80%93_the_cosmic_calendar.webm",
