      },
      "segments": [
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:000",
          "start_ms": 1000,
          "end_ms": 6500,
          "original_text": "With the big bang starting the year and as cheering new year's eve one year later",
          "translations": {
            "vi": "Vụ Nổ Lớn mở đầu năm, và một năm sau ta reo hò đón giao thừa.",
            "zh": "宇宙大爆炸拉开这一年的序幕，一年后我们欢呼迎接新年前夜。"
          }
        },
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:001",
          "start_ms": 7500,
          "end_ms": 12500,
          "original_text": "Using this scale the universe slowed and cooled for the first few days of January",
          "translations": {
            "vi": "Theo tỉ lệ này, vũ trụ chậm lại và nguội đi trong vài ngày đầu tháng Giêng.",
            "zh": "按这个比例，宇宙在一月的头几天里减速并冷却。"
          }
        },
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:002",
          "start_ms": 13500,
          "end_ms": 19000,
          "original_text": "The first stars formed on the 5th of January and the first galaxies formed on the 9th",
          "translations": {
            "vi": "Những ngôi sao đầu tiên hình thành ngày 5 tháng Giêng, thiên hà đầu tiên ngày 9.",
            "zh": "第一批恒星在1月5日形成，第一批星系在1月9日形成。"
          }
        },
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:003",
          "start_ms": 20600,
          "end_ms": 27600,
          "original_text": "For the thin disk of the Milky Way Galaxy didn't form until May Our Solar System and Earth formed in September",
          "translations": {
            "vi": "Đĩa mỏng của Ngân Hà mãi đến tháng Năm mới hình thành. Hệ Mặt Trời và Trái Đất hình thành vào tháng Chín.",
            "zh": "银河系的薄盘直到五月才形成。太阳系和地球形成于九月。"
          }
        },
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:004",
          "start_ms": 29000,
          "end_ms": 34500,
          "original_text": "Dinosaurs evolved on the 25th of December and were already extinct by the 30th",
          "translations": {
            "vi": "Khủng long tiến hóa ngày 25 tháng Chạp và đã tuyệt chủng trước ngày 30.",
            "zh": "恐龙在12月25日演化出现，到12月30日就已经灭绝了。"
          }
        },
        {
          "segment_id": "commons-royalsociety-cosmic-calendar:005",
          "start_ms": 36000,
          "end_ms": 47000,
          "original_text": "The first known cave paintings date from 90 seconds to midnight on New Year's Eve and the pyramids were built only 12 seconds ago",
          "translations": {
            "vi": "Những bức vẽ hang động sớm nhất có từ 90 giây trước nửa đêm giao thừa, còn kim tự tháp chỉ mới được xây cách đây 12 giây.",
            "zh": "已知最早的洞穴壁画出现在除夕午夜前90秒，而金字塔只是在12秒前才建成的。"
          }
        }
      ]
    },
