      },
      "poster_url": "https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Deep_time_and_cosmic_history_as_one_year_%E2%80%93_the_cosmic_calendar.webm/960px--Deep_time_and_cosmic_history_as_one_year_%E2%80%93_the_cosmic_calendar.webm.jpg",
      "rights": {
        "license_name": "CC BY 3.0",
        "license_url": "https://creativecommons.org/licenses/by/3.0/",
        "provenance_url": "https://commons.wikimedia.org/wiki/File:Deep_time_and_cosmic_history_as_one_year_%E2%80%93_the_cosmic_calendar.webm",
        "allowed_usage_type": "creative-commons-attribution",
