# AI model used by the Writing Coach
OLLAMA_MODEL=qwen3:8b

# Ollama runs natively on the Windows host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180

# Recommended: do not silently create fake demo scores if Ollama is unavailable.
ALLOW_FALLBACK=false

# Optional for local development. Required for production-like tunnel staging;
# never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Safe local/developer defaults. This example supports:
#   Copy-Item .env.example .env
#   docker compose up -d --build
# APP_ENV: development (a developer's machine, a lane runtime such as :8021), staging (public and product-like:
# :8000 and the public domain; HTTPS PUBLIC_BASE_URL, Google OAuth and a SESSION_SECRET of 32+ characters are
# required, developer docs are hidden, no local admin), production (the final product; not in use yet). APP_ENV is
# never a feature switch: each learner capability has its own flag (D-146).
APP_ENV=development
APP_BIND_HOST=127.0.0.1
# Reachable from other machines on the LAN (deliberate, insecure): set ORENA_INSECURE_DEV_LAN_BIND_HOST=0.0.0.0 and
# configure Google sign-in (GOOGLE_CLIENT_ID/SECRET, SESSION_SECRET). With sign-in off, development is loopback-only
# and the app refuses to start with this set (docs/SECURITY_BOUNDARY.md).
# ORENA_INSECURE_DEV_LAN_BIND_HOST=
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override. Normally derived as PUBLIC_BASE_URL/auth/google/callback.
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
BOOTSTRAP_OWNER_EMAIL=


# Optional platform AI providers - developer/server config only
PLATFORM_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
CLOUD_AI_TIMEOUT=180

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODELS=

# OpenRouter (free ":free" models only; D-195). The owner enters the key here or in Admin; never commit a value.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=
# PR-MON-7: Ollama Cloud, a cloud provider distinct from the local Ollama (never a local tier). Priced like any paid
# provider even while provider credits cover it. No model is reviewed for learner text yet; list only reviewed ids.
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODELS=
# PR-MON-7A-first: capabilities taken off the legacy selection onto their reviewed chain (comma-separated; only
# writing_evaluator, writing_improver, text_discussion are routable). Empty = everything stays as today.
ORENA_CAPABILITY_ROUTING=

# Orena Intelligence (/api/agent/*). Off by default. This flag is the switch in
# every environment (D-146); turning it on where learners are is the human's call.
AGENT_ENABLED=false
# Deletes agent.turn telemetry older than 90 days, once a day. Off by default;
# switched on only after its independent review (true/false; anything else
# refuses to start).
AGENT_TURN_RETENTION_SWEEP=false
# Live voice for Orena (mode A, Gemini Live; /api/agent/voice/*). Off by default; only where the agent is on.
# Uses the Gemini key the AI platform resolves; the key never reaches a client.
AGENT_VOICE_ENABLED=false
# How an agent turn's request is laid out for prompt caching (ORENA_MEMORY.md §5.4): legacy (default) or stable (the
# context split around the conversation; for the capped live benchmark, and the default only once it shows no
# regression). AGENT_STABLE_TOOLS=on lists the same tools on every round (off). Any other value refuses to start.
AGENT_PROMPT_LAYOUT=legacy
# The system-wide daily AI spend ceiling in USD (owner, 2026-10-18: 5 on :8000): today's (UTC) spend across the
# whole AI ledger at its prices (a free-plan call at list price): every capability, speech recognition,
# pronunciation scoring, word audio, media AI and ASR. Once reached, until the next UTC midnight: Orena chat and
# voice are refused, and so is every paid model call (a primary, a backup, any capability), every paid media step,
# Listening/Reading translation, Speaking recognition and pronunciation scoring; new word audio gives way to the
# local or device voice. Local and free models, cached audio and features without AI still work.
# A warning is logged once a day at AI_DAILY_SPEND_WARN_RATIO of it (default 0.8). Admin: GET /api/admin/ai-spend
# (no Admin notice is drawn yet). Empty: no ceiling. An unreadable value refuses to start.
AI_DAILY_SPEND_CEILING_USD=
AI_DAILY_SPEND_WARN_RATIO=0.8
AGENT_STABLE_TOOLS=off
# The learner pack (ORENA_MEMORY.md M1): profile and learning evidence from the learner's own records, sent to the chat
# and voice model with every turn. Off by default (on | off; anything else refuses to start).
AGENT_LEARNER_PACK=off
# Provider data classes (ORENA_MEMORY.md §8, G8 - staged): which learner data each provider may receive, set by the
# owner after reading the provider's retention and training terms: provider=class or provider:model=class,
# comma-separated; class is none, learning_profile or full_memory. A provider not listed is none. Applies only with
# AGENT_LEARNER_PACK=on: the pack and the chat context's learning evidence need learning_profile, coach notes need
# full_memory, and a conversation is never continued on a provider cleared for less than it already sent. Not governed
# yet: the opening snapshot, the learner's text and tool results.
# Example: AGENT_PROVIDER_DATA_CLASSES=gemini=learning_profile
AGENT_PROVIDER_DATA_CLASSES=
# Orena Memory (ORENA_MEMORY.md M2, migration 0035): the versioned HMAC keys for memory dedupe and suppression,
# v1:<secret> (later v1:<old>,v2:<new>; the highest is current; each secret at least 32 characters). Generate once per
# environment and keep it across deploys in that environment's secret store; never commit or regenerate it. Empty:
# this server has no Orena Memory. It also needs an active account backbone (ORENA_ACCOUNT_BACKBONE) and, for memory to
# reach a model, a provider cleared for full_memory above. A malformed value refuses to start.
AGENT_MEMORY_HMAC_KEYS=
# Expired Orena Memory rows (a kept note expires 180 days after it was last asked for: the pilot keeps learner
# data up to 6 months) are deleted by a daily sweep started by agent turns, in bounded batches. Off by default:
# automatic deletion is a destructive lifecycle change, switched on by the owner (on | off; anything else
# refuses to start). Off, expired notes are already invisible and are removed when the learner keeps a note.
AGENT_MEMORY_RETENTION_SWEEP=off

# Application runtime persistence: PostgreSQL by default in local development
# and staging. SQLite is retained only for explicit tests, cache/archive
# inspection, and one-way SQLite -> PostgreSQL import tooling.
PERSISTENCE_BACKEND=postgresql
POSTGRES_RUNTIME_URL=postgresql+psycopg://becoming:becoming-local-dev@postgres:5432/becoming
# Migration/rehearsal/parity only; never a runtime selector.
POSTGRES_SHADOW_URL=
# If POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB are customized, set
# POSTGRES_RUNTIME_URL to the matching values as well.
# Production-like staging additionally requires APP_BIND_HOST=127.0.0.1,
# OAuth/session secrets, and CLOUDFLARE_TUNNEL_TOKEN. Validate an ignored local
# .env before staging:
# python scripts/validate_public_staging_readiness.py --env-file .env

# External media transcript fallback. Paid/provider failover is opt-in rather
# than activated merely because a credential exists.
MEDIA_TRANSCRIPT_FALLBACK=none
SUPADATA_API_KEY=
SUPADATA_REQUEST_TIMEOUT_SECONDS=20
SUPADATA_MAX_WAIT_SECONDS=150
SUPADATA_POLL_INTERVAL_SECONDS=1

# Speech ASR provider. Keep the real key out of Git.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Restrict the model picker to a comma-separated list; empty asks Groq for its catalog.
GROQ_MODELS=
# Which engine translates shared media: groq (default when GROQ_API_KEY is set)
# or local (the Marian service, kept as the no-external-dependency backup).
# Resolved once at startup. With groq, a batch Groq cannot take (a long rate limit, a spent quota, a fault, no key) goes
# to the router capabilities media_translation / media_transcript_correction if the operator configured them in Admin
# (D-224, proposed); ai uses the router only. The Groq key may also be saved in Admin, which wins over this file.
MEDIA_TRANSLATION_PROVIDER=
GROQ_TRANSLATION_MODEL=openai/gpt-oss-120b
# Optional: the model's output-tokens-per-minute limit (qwen/qwen3.8-27b: 1000). Empty = learned from the provider's first OTPM refusal.
GROQ_TRANSLATION_OUTPUT_TOKENS_PER_MINUTE=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_ASR_TIMEOUT_SECONDS=120
GROQ_ASR_MAX_BYTES=25165824

# Pronunciation provider: azure | demo | none. Empty chooses Azure when the key
# and region below are set, and no scorer otherwise (no synthetic scores, D-066).
# "demo" returns labelled synthetic values for API work only, never in production,
# and the learner UI never draws them as a score.
PRONUNCIATION_PROVIDER=

# Azure Speech Pronunciation Assessment. Server-side only: the key never reaches
# the browser, a log or the repository. Keep the real key out of Git.
# English defaults to en-US so the provider can return prosody when available.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_PRONUNCIATION_EN_LOCALE=en-US
AZURE_PRONUNCIATION_ZH_LOCALE=zh-CN
# Separately charged add-on; disabled unless explicitly chosen.
AZURE_PRONUNCIATION_ENABLE_PROSODY=false
AZURE_PRONUNCIATION_TIMEOUT_SECONDS=30
AZURE_PRONUNCIATION_MAX_BYTES=8388608
AZURE_PRONUNCIATION_MAX_REFERENCE_CHARS=1200

# Saved provider credentials are encrypted at rest with this key. Generate one
# per deployment and keep it out of Git; without it the console refuses to save
# a provider key and says so, which is the correct closed state rather than a
# silent plaintext one. Rotating it makes existing saved credentials
# unreadable, so they have to be entered again.
AI_PROVIDER_SECRETS_KEY=

# Where imported content lives. The application's defaults are repo-relative,
# which suits a checkout and not a container: compose overrides both onto the
# persistent /data volume so a recreate keeps the media index, the transcripts,
# the lifecycle state and the asset bytes. Override them only to move that
# storage somewhere else that is equally persistent.
MEDIA_LIBRARY_ROOT=
MEDIA_LIBRARY_ASSET_ROOT=
READING_LIBRARY_ASSET_ROOT=

# --- Billing (names only; every value is a human gate, and BILLING_ENABLED stays off by default) -------------------
BILLING_ENABLED=
BILLING_PRICES_FILE=
BILLING_CREDIT_PACKS_FILE=
# PR-MON-8 §14 (D-MON-032): the domestic gateway that tops up Credits: payos | sepay. Required (in production) only
# when Credits is configured (packs or CREDITS_ENABLED); a plans-only runtime (Polar) leaves it empty. Plans are Polar only.
BILLING_DOMESTIC_GATEWAY=
# PR-MON-10 rollback: off closes new checkouts only; webhooks, the Polar portal and clean-up keep running. Default on.
BILLING_NEW_SALES=
CREDITS_ENABLED=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=
# SePay + VietinBank (PR-MON-8). Separate credentials for test mode and production; never commit values.
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_BIN=
SEPAY_PAYMENT_PREFIX=
# The virtual account the QR shows instead of the main account (required in production, D-MON-030).
SEPAY_VA_NUMBER=
SEPAY_API_TOKEN=
SEPAY_API_BASE=
# The recovery feed runs only with SEPAY_API_TOKEN AND this switch on (off by default).
SEPAY_FEED_ENABLED=
