    "summary": {
      "vi": "Bổ ngữ xu hướng kép như 起来, 下去, 出来 diễn tả hướng hoặc kết quả của một hành động, thường mở rộng nghĩa sang trạng thái bắt đầu, tiếp diễn hay nhận ra.",
      "en": "Compound directional complements such as 起来, 下去, 出来 express the direction or result of an action, often extending to meanings like starting, continuing, or figuring something out."
    },
    "sub": {"vi": "xu hướng kép", "en": "compound direction"},
    "native_title_pinyin": ["qū", "xiàng", "bǔ", "yǔ", ""]
  },
  "when_to_use": [
    {
      "vi": "Khi muốn nói một hành động bắt đầu và tiếp tục, dùng 起来 sau động từ.",
      "en": "When you want to say an action starts and continues, use 起来 after the verb."
    },
    {
      "vi": "Khi muốn nói một hành động tiếp diễn theo hướng đi xuống hoặc kéo dài, dùng 下去 sau động từ.",
      "en": "When you want to say an action continues downward or goes on, use 下去 after the verb."
    },
    {
      "vi": "Khi muốn nói nhận ra, tìm ra hoặc làm cho rõ một điều gì đó, dùng 出来 sau động từ.",
      "en": "When you want to say you figure out, discover, or make something clear, use 出来 after the verb."
    },
    {
      "vi": "Khi muốn nói một hành động hướng ra ngoài hoặc kết quả lộ ra, dùng 出来 sau động từ.",
      "en": "When you want to say an action moves outward or a result becomes visible, use 出来 after the verb."
    }
  ],
