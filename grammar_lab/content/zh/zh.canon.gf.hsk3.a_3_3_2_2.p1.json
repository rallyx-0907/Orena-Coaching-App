    "title": {"vi": "Ngữ pháp tiếng Trung: 看起来", "en": "Chinese grammar: 看起来"},
    "native_title": "看起来",
    "level": {"framework": "hsk3", "value": "3", "rank": 3},
    "summary": {
      "vi": "看起来 dùng để nói điều mình quan sát hoặc cảm nhận qua vẻ bề ngoài, theo sau là một nhận xét.",
      "en": "看起来 introduces what you observe or feel from outward appearance, followed by a comment."
    },
    "sub": {"vi": "nhìn có vẻ", "en": "it looks / seems"},
    "native_title_pinyin": ["kàn", "qǐ", "lái"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói điều mình thấy qua mắt, chưa chắc đã đúng: 他看起来很高兴。",
      "en": "When you say what you see with your eyes, without claiming it is certain: 他看起来很高兴。"
    },
    {
      "vi": "Khi nhận xét một người, một vật hoặc một tình huống dựa trên vẻ bề ngoài: 这个菜看起来很好吃。",
      "en": "When commenting on a person, thing or situation based on how it appears: 这个菜看起来很好吃。"
    },
    {
      "vi": "Khi muốn nói một việc có vẻ sắp xảy ra: 看起来要下雨了。",
      "en": "When saying something seems about to happen: 看起来要下雨了。"
    }
  ],
