    "level": {"framework": "hsk3", "value": "1", "rank": 1},
    "summary": {
      "vi": "有 dùng để nói ai đó có cái gì (sở hữu) hoặc ở đâu đó có cái gì (tồn tại).",
      "en": "有 is used to say that someone has something (possession) or that something exists somewhere (existence)."
