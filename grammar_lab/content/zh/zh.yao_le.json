    "native_title": "“要……了”",
    "level": {"framework": "hsk3", "value": "2", "rank": 2},
    "summary": {
      "vi": "Mẫu câu 要……了 dùng để nói một việc sắp xảy ra hoặc một kế hoạch đã định trong tương lai gần.",
      "en": "The pattern 要……了 expresses that something is about to happen or is a plan already set for the near future."
    },
    "sub": {"vi": "kế hoạch sắp tới", "en": "near-future plans"},
    "native_title_pinyin": ["", "yào", "", "", "le", ""]
  },
  "when_to_use": [
    {
      "vi": "Khi một việc sẽ xảy ra rất sớm, thường là trong hôm nay hoặc vài ngày tới.",
      "en": "When something will happen very soon, usually today or within the next few days."
    },
    {
      "vi": "Khi người nói đã quyết định hoặc đã sắp xếp một kế hoạch, không phải chỉ dự đoán.",
      "en": "When the speaker has already decided or arranged a plan, not just making a guess."
    },
    {
      "vi": "Khi muốn thông báo một thay đổi sắp tới, ví dụ trời sắp mưa, sắp đến giờ học.",
      "en": "When announcing an upcoming change, for example it is about to rain or class is about to start."
    }
