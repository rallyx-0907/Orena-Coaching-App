  "header": {
    "title": {"vi": "Ngữ pháp tiếng Trung: “把”字句5：表致使", "en": "Chinese grammar: “把”字句5：表致使"},
    "native_title": "“把”字句5：表致使",
    "level": {"framework": "hsk3", "value": "8", "rank": 8},
    "summary": {
      "vi": "Câu chữ 把 dùng để nói rõ kết quả hoặc tình trạng mà hành động gây ra cho đối tượng, tức là làm cho đối tượng biến thành thế nào.",
      "en": "The 把 sentence used to state the result or state that an action causes in an object, that is, what the object is made to become."
    },
    "sub": {"vi": "kết quả gây ra", "en": "caused result"},
    "native_title_pinyin": ["", "bǎ", "", "zì", "jù", "", "", "biǎo", "zhì", "shǐ"]
  },
  "when_to_use": [
    {
      "vi": "Khi muốn nói hành động làm cho đối tượng thay đổi trạng thái, chứ không chỉ nói hành động đã xảy ra.",
      "en": "When you want to say an action changes the object's state, not merely that the action happened."
    },
    {
      "vi": "Khi sau động từ cần có kết quả cụ thể như 成, 坏, 干净, 好 để cho biết đối tượng thành ra thế nào.",
      "en": "When the verb needs a concrete result such as 成, 坏, 干净, 好 to show what the object becomes."
    },
    {
      "vi": "Khi đối tượng đã được xác định và người nói muốn nhấn mạnh cách xử lý nó.",
      "en": "When the object is already identified and the speaker wants to stress how it is handled."
    },
    {
      "vi": "Khi câu có 把 mà không có kết quả đi kèm thì nghe như câu bỏ dở, nên cần thêm phần kết quả.",
      "en": "When a 把 sentence without a result sounds unfinished, so the result part is required."
    }
  ],
