    "level": {"framework": "hsk3", "value": "1", "rank": 1},
    "summary": {
      "vi": "Động từ năng nguyện 想 và 要 đứng trước động từ chính để nói điều mình muốn hoặc cần làm.",
      "en": "The modal verbs 想 and 要 come before a main verb to express what someone wants or needs to do."
    },
    "sub": {"vi": "mong muốn và nhu cầu", "en": "wants and needs"},
    "native_title_pinyin": ["néng", "yuàn", "dòng", "cí", "", "xiǎng", "", "yào"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói mình mong muốn làm gì đó một cách nhẹ nhàng, dùng 想 trước động từ.",
      "en": "Use 想 before a verb to say gently that you would like to do something."
    },
    {
      "vi": "Khi bạn muốn nói mình cần hoặc nhất định phải làm gì đó, dùng 要 trước động từ.",
      "en": "Use 要 before a verb to say you need or intend to do something."
    },
    {
      "vi": "Khi phủ định mong muốn, dùng 不想; khi phủ định nhu cầu, dùng 不用.",
      "en": "To negate a wish use 不想; to negate a need use 不用."
    },
    {
      "vi": "Khi hỏi ý người khác, đặt 想 hay 要 trước động từ và thêm 吗 ở cuối câu.",
      "en": "To ask about someone's intention, put 想 or 要 before the verb and add 吗 at the end."
    }
  ],
