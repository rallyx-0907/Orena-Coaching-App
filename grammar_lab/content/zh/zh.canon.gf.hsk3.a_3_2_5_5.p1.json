  "header": {
    "title": {"vi": "Ngữ pháp tiếng Trung: 把、被、叫、让", "en": "Chinese grammar: 把、被、叫、让"},
    "native_title": "把、被、叫、让",
    "level": {"framework": "hsk3", "value": "3", "rank": 3},
    "summary": {
      "vi": "Cấu trúc 把、被、叫、让 dùng để nhấn mạnh kết quả của việc xử lý một đối tượng: 把 đưa đối tượng lên trước động từ, còn 被、叫、让 đánh dấu câu bị động.",
      "en": "The patterns 把, 被, 叫 and 让 stress the result of handling an object: 把 moves the object before the verb, while 被, 叫 and 让 mark passive sentences."
    },
    "sub": {"vi": "xử lý và bị động", "en": "disposal and passive"},
    "native_title_pinyin": ["bǎ", "", "bèi", "", "jiào", "", "ràng"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói mình đã làm gì với một vật và kết quả ra sao, dùng 把 + tân ngữ + động từ + kết quả.",
      "en": "When you want to say what you did to an object and how it turned out, use 把 + object + verb + result."
    },
    {
      "vi": "Khi chủ ngữ là người hoặc vật chịu tác động, dùng 被、叫 hoặc 让 trước tác nhân.",
      "en": "When the subject is the one affected by an action, use 被, 叫 or 让 before the agent."
    },
    {
      "vi": "Khi câu bị động không cần nêu ai làm, có thể bỏ tác nhân sau 被.",
      "en": "When the passive sentence does not need to name who did it, you can leave out the agent after 被."
    },
    {
      "vi": "Khi động từ chính cần có kết quả rõ ràng như 完、好、走、到, đừng dùng động từ trần trong câu 把 hoặc 被.",
      "en": "When the main verb needs a clear result such as 完, 好, 走 or 到, do not use a bare verb in a 把 or 被 sentence."
    }
  ],
