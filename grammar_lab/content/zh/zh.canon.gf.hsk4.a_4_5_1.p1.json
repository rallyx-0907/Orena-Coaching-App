  "header": {
    "title": {"vi": "Mẫu câu đặc biệt: “把”字句2：表处置", "en": "Special sentence patterns: “把”字句2：表处置"},
    "native_title": "“把”字句2：表处置",
    "level": {"framework": "hsk3", "value": "4", "rank": 4},
    "summary": {
      "vi": "Mẫu câu chữ 把 dùng để nói rõ kết quả của việc xử lý một đối tượng: đối tượng được đưa lên trước động từ, sau đó là kết quả hoặc thay đổi.",
      "en": "The 把 sentence states the result of handling an object: the object moves before the verb, and the result or change follows the verb."
    },
    "sub": {"vi": "xử lý và kết quả", "en": "handling and result"},
    "native_title_pinyin": ["", "bǎ", "", "zì", "jù", "", "", "biǎo", "chǔ", "zhì"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói mình đã làm gì đó khiến đối tượng thay đổi trạng thái, chứ không chỉ nói hành động đã xảy ra.",
      "en": "When you want to say what you did to an object and how it changed, not just that an action happened."
    },
    {
      "vi": "Khi câu cần nêu rõ kết quả, vị trí mới, hoặc mức độ hoàn thành của việc xử lý.",
      "en": "When the sentence needs to state the result, the new position, or how completely the object was handled."
    },
    {
      "vi": "Khi đối tượng đã được xác định rõ (người nghe biết là cái nào), nên đặt nó sau 把.",
      "en": "When the object is already specific and known to the listener, so it can go after 把."
    },
    {
      "vi": "Khi bạn muốn nhấn mạnh ai đó đã xử lý đối tượng thế nào, thay vì chỉ kể lại sự việc.",
      "en": "When you want to stress how someone handled the object rather than simply report the event."
    }
  ],
