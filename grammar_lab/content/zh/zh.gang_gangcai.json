    "native_title": "刚/刚才",
    "level": {"framework": "hsk3", "value": "3", "rank": 3},
    "summary": {
      "vi": "Phân biệt 刚 và 刚才 khi nói về một việc vừa mới xảy ra.",
      "en": "Distinguish 刚 and 刚才 when talking about something that just happened."
    },
    "sub": {"vi": "vừa mới / vừa nãy", "en": "just / just now"},
    "native_title_pinyin": ["gāng", "", "gāng", "cái"]
