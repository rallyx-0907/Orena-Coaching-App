  "when_to_use": [
    {
      "vi": "Dùng 刚 trước động từ để nhấn mạnh việc xảy ra rất gần đây, thường đi với 就 hoặc 才.",
      "en": "Use 刚 before a verb to stress that something happened a very short time ago, often with 就 or 才."
    },
    {
      "vi": "Dùng 刚才 như một mốc thời gian đứng đầu câu hoặc trước động từ, chỉ khoảng thời gian vừa qua.",
      "en": "Use 刚才 as a time expression at the start of a sentence or before the verb, referring to the recent past."
    },
    {
      "vi": "Không dùng 刚 với phủ định 不; muốn nói 'vừa mới không' thì dùng 刚才.",
      "en": "Do not use 刚 with the negative 不; to say something did not just happen, use 刚才."
    }
  ],
