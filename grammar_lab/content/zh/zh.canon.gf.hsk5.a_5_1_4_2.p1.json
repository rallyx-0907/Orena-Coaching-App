  "header": {
    "title": {"vi": "Ngữ pháp tiếng Trung: 将", "en": "Chinese grammar: 将"},
    "native_title": "将",
    "level": {"framework": "hsk3", "value": "5", "rank": 5},
    "summary": {
      "vi": "Cấu trúc 将 dùng để đưa tân ngữ lên trước động từ, nhấn mạnh cách xử lý hoặc sắp đặt đối tượng, thường dùng trong văn viết và tình huống trang trọng.",
      "en": "The 将 construction moves the object before the verb to highlight how something is handled or arranged, and it is common in written and formal Chinese."
    },
    "sub": {"vi": "cấu trúc 将", "en": "the 将 construction"},
    "native_title_pinyin": ["jiāng"]
  },
  "when_to_use": [
    {
      "vi": "Khi muốn nhấn mạnh đối tượng được xử lý thế nào, nhất là trong văn viết hoặc thông báo trang trọng.",
      "en": "When you want to highlight how an object is handled, especially in writing or formal announcements."
    },
    {
      "vi": "Khi câu có tân ngữ xác định và động từ diễn tả hành động cụ thể lên tân ngữ đó.",
      "en": "When the sentence has a definite object and the verb describes a concrete action on that object."
    },
    {
      "vi": "Khi cần tránh lặp lại cấu trúc 把 trong cùng một đoạn văn trang trọng.",
      "en": "When you need to avoid repeating 把 in the same formal passage."
    },
    {
      "vi": "Khi muốn câu văn gọn và có nhịp điệu trang trọng hơn cấu trúc thông thường.",
      "en": "When you want a sentence that is more compact and formal in rhythm than the ordinary structure."
    }
  ],
