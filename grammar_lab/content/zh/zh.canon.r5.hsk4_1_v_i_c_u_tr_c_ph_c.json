  "header": {
    "title": {
      "vi": "Ngữ pháp tiếng Trung: 把 với cấu trúc phức",
      "en": "Chinese grammar: 把 với cấu trúc phức"
    },
    "native_title": "复杂把字句",
    "level": {"framework": "hsk3", "value": "4", "rank": 4},
    "summary": {
      "vi": "Câu chữ 把 với vị ngữ phức hợp dùng để nói rõ kết quả, mức độ, hướng hoặc đích đến của hành động tác động lên một đối tượng cụ thể.",
      "en": "The 把 construction with a complex predicate states the result, degree, direction, or endpoint of an action performed on a specific object."
    },
    "sub": {"vi": "xử lý có kết quả", "en": "disposal with result"},
    "native_title_pinyin": ["fù", "zá", "bǎ", "zì", "jù"]
  },
  "when_to_use": [
    {
      "vi": "Khi đối tượng bị tác động đã xác định và người nói muốn nhấn mạnh kết quả hoặc cách xử lý nó.",
      "en": "When the affected object is already specific and the speaker wants to highlight the result or the way it is handled."
    },
    {
      "vi": "Khi vị ngữ cần thêm bổ ngữ kết quả, bổ ngữ mức độ với 得, bổ ngữ hướng hoặc cụm chỉ đích đến.",
      "en": "When the predicate needs a result complement, a degree complement with 得, a directional complement, or a phrase showing the endpoint."
    },
    {
      "vi": "Khi muốn đổi trật tự câu thường thành cấu trúc 把 để làm nổi bật hành động và kết quả thay vì chỉ nêu chủ thể và đối tượng.",
      "en": "When you want to shift a neutral sentence into 把 order to foreground the action and its result rather than just subject and object."
    },
    {
      "vi": "Khi câu có thêm 都, 给, 成, 到, 在 hoặc 得 để mở rộng vị ngữ sau động từ chính.",
      "en": "When the sentence adds 都, 给, 成, 到, 在, or 得 to expand the predicate after the main verb."
    }
  ],
