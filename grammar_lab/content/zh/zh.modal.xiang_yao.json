    "native_title": "能愿动词“想/要”",
    "level": {"framework": "hsk3", "value": "1", "rank": 1},
    "summary": {
      "vi": "能愿动词“想”和“要”đứng trước động từ để diễn tả mong muốn hoặc dự định làm việc gì đó.",
      "en": "The modal verbs 想 and 要 come before a verb to express a wish or a plan to do something."
    },
    "sub": {"vi": "mong muốn, dự định", "en": "wishes and plans"},
    "native_title_pinyin": ["néng", "yuàn", "dòng", "cí", "", "xiǎng", "", "yào", ""]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói mình mong muốn làm gì đó một cách nhẹ nhàng, dùng 想 + động từ.",
      "en": "When you want to say you would like to do something in a softer way, use 想 + verb."
    },
    {
      "vi": "Khi bạn nói một dự định hoặc ý định khá chắc chắn, dùng 要 + động từ.",
      "en": "When you state a fairly firm plan or intention, use 要 + verb."
    },
    {
      "vi": "Khi phủ định mong muốn, dùng 不想; khi phủ định dự định mạnh, dùng 不要.",
      "en": "To negate a wish, use 不想; to negate a strong plan, use 不要."
    },
    {
      "vi": "Khi hỏi ý muốn hoặc dự định của người khác, dùng 想不想 hoặc 要不要.",
      "en": "To ask about someone's wish or plan, use 想不想 or 要不要."
    }
  ],
