  "header": {
    "title": {"vi": "Động từ ly hợp", "en": "Separable verbs"},
    "native_title": "离合词",
    "level": {"framework": "hsk3", "value": "2", "rank": 2},
    "summary": {
      "vi": "Động từ ly hợp là từ gồm hai phần (động từ + tân ngữ) nhưng hoạt động như một động từ, và các thành phần như 了, 过, số lượng có thể chen vào giữa hai phần đó.",
      "en": "Separable verbs look like one verb but are made of a verb plus an object; aspect markers and quantity words go between the two parts."
    },
    "sub": {"vi": "động từ ly hợp", "en": "separable verbs"},
    "native_title_pinyin": ["lí", "hé", "cí"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn dùng các từ như 见面, 帮忙, 洗澡, 睡觉, 结婚, 请假.",
      "en": "When you use words like 见面, 帮忙, 洗澡, 睡觉, 结婚, 请假."
    },
    {
      "vi": "Khi muốn nói đã làm, từng làm, hoặc làm bao nhiêu lần: 了, 过, số lần chen vào giữa.",
      "en": "When you say it happened, has happened, or how many times: 了, 过 and count words go in the middle."
    },
    {
      "vi": "Khi muốn nói làm cùng ai, phải dùng 跟/和 + người trước động từ, không đặt người ngay sau.",
      "en": "When you say who you did it with, use 跟/和 + person before the verb, not right after it."
    },
    {
      "vi": "Khi muốn nói thời lượng hoặc số lượng của hành động: 洗了个澡, 睡了一会儿觉.",
      "en": "When you give the duration or amount of the action: 洗了个澡, 睡了一会儿觉."
    }
  ],
