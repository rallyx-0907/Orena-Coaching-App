    "summary": {
      "vi": "Trợ từ động thái 过 đặt sau động từ để nói rằng chủ thể đã từng trải qua hành động đó ít nhất một lần trong quá khứ, tính đến hiện tại.",
      "en": "过 after a verb says the subject has had that experience before."
    },
    "sub": {"vi": "đã từng", "en": "have done before"},
    "native_title_pinyin": ["dòng", "tài", "zhù", "cí", "", "guò", ""]
