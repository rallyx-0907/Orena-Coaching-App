    "native_title": "兼语句“请/让”",
    "level": {"framework": "hsk3", "value": "3", "rank": 3},
    "summary": {
      "vi": "Mẫu câu兼语句 dùng 请 hoặc 让 để nói ai đó nhờ, bảo hoặc để cho người khác làm việc gì.",
      "en": "The pivotal (兼语句) pattern with 请 or 让 says that someone asks, tells, or lets another person do something."
    },
    "sub": {"vi": "请/让 + ai làm gì", "en": "请/让 + someone does"},
    "native_title_pinyin": ["jiān", "yǔ", "jù", "", "qǐng", "", "ràng", ""]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn nhờ ai đó làm việc gì một cách lịch sự, dùng 请.",
      "en": "Use 请 when you politely ask someone to do something."
    },
    {
      "vi": "Khi bạn bảo, sai khiến hoặc để cho ai đó làm việc gì, dùng 让.",
      "en": "Use 让 when you tell, make, or let someone do something."
    },
    {
      "vi": "Khi người được nhờ hoặc được bảo là đối tượng trực tiếp của 请/让, và theo sau là động từ hành động.",
      "en": "Use it when the person asked or told is the direct object of 请/让, followed by an action verb."
    },
    {
      "vi": "Khi muốn nói ngắn gọn ai làm gì cho ai, không cần thêm 我/你/他 ở đầu câu thứ hai.",
      "en": "Use it to say briefly who does what for whom, without adding another subject before the second verb."
    }
  ],
