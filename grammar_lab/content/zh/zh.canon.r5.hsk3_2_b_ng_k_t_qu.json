  "header": {
    "title": {"vi": "Ngữ pháp tiếng Trung: 把 + bổ ngữ kết quả", "en": "Chinese grammar: 把 + bổ ngữ kết quả"},
    "native_title": "把字句+结果补语",
    "level": {"framework": "hsk3", "value": "3", "rank": 3},
    "summary": {
      "vi": "Cấu trúc 把 đưa tân ngữ lên trước động từ để nhấn mạnh kết quả của việc xử lý tân ngữ đó.",
      "en": "The 把 construction moves the object before the verb to stress the result of handling that object."
    },
    "sub": {"vi": "xử lý và kết quả", "en": "disposal and result"},
    "native_title_pinyin": ["bǎ", "zì", "jù", "", "jié", "guǒ", "bǔ", "yǔ"]
  },
  "when_to_use": [
    {
      "vi": "Khi bạn muốn nói rõ mình đã làm gì với một vật và kết quả ra sao, chứ không chỉ kể sự việc.",
      "en": "Use it when you want to say what you did to something and how it turned out, not just report an event."
    },
    {
      "vi": "Khi tân ngữ là vật cụ thể đã biết (作业, 名字, 钥匙), không phải thông tin mới.",
      "en": "Use it when the object is a specific, already-known thing (作业, 名字, 钥匙), not new information."
    },
    {
      "vi": "Khi động từ cần thêm bổ ngữ kết quả như 完, 好, 到, 见, 错 để câu tự nhiên.",
      "en": "Use it when the verb needs a result complement such as 完, 好, 到, 见, 错 to sound complete."
    },
    {
      "vi": "Khi muốn nhấn mạnh kết quả hoàn thành hoặc kết quả sai, thường có 了 ở cuối.",
      "en": "Use it to foreground a completed or mistaken result, usually with 了 at the end."
    }
  ],
