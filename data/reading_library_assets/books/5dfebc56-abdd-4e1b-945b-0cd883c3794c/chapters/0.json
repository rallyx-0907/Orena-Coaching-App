{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u5173\u4e8e\u8fd9\u4e2a\u6d4b\u8bd5\u6587\u4ef6"}, {"type": "paragraph", "text": "\u8fd9\u662f\u4e3a Orena \u7684 EPUB \u5bfc\u5165\u3001\u4e66\u5e93\u5361\u7247\u3001\u5c01\u9762\u3001\u76ee\u5f55\u3001\u7ae0\u8282\u5bfc\u822a\u3001\u4e2d\u6587\u6392\u7248\u548c\u9605\u8bfb\u5668\u754c\u9762\u6d4b\u8bd5\u5236\u4f5c\u7684\u6837\u672c\u3002\u539f\u8457\u300aAlice's Adventures in Wonderland\u300b\u5df2\u8fdb\u5165\u516c\u6709\u9886\u57df\uff1b\u672c\u6587\u4ef6\u4e2d\u7684\u4e2d\u6587\u6587\u5b57\u4e3a\u6d4b\u8bd5\u7528\u9014\u91cd\u65b0\u8868\u8ff0\uff0c\u5e76\u975e\u8f6c\u8f7d\u4efb\u4f55\u73b0\u884c\u5546\u4e1a\u4e2d\u6587\u7248\u3002"}, {"type": "paragraph", "text": "\u6587\u4ef6\u5305\u542b\u5c01\u9762\u3001\u5143\u6570\u636e\u3001\u5341\u4e8c\u7ae0\u76ee\u5f55\u3001\u4e2d\u6587\u6b63\u6587\u3001\u82f1\u6587\u526f\u6807\u9898\u53ca\u57fa\u672c CSS\uff0c\u53ef\u7528\u4e8e\u68c0\u67e5\u4e66\u5e93\u7f29\u7565\u56fe\u3001\u6807\u9898\u622a\u65ad\u3001\u7ae0\u8282\u5217\u8868\u3001\u5b57\u4f53\u56de\u9000\u3001\u6bb5\u843d\u95f4\u8ddd\u3001\u6eda\u52a8\u9605\u8bfb\u548c\u79fb\u52a8\u7aef\u663e\u793a\u3002"}], "paragraphs": ["\u8fd9\u662f\u4e3a Orena \u7684 EPUB \u5bfc\u5165\u3001\u4e66\u5e93\u5361\u7247\u3001\u5c01\u9762\u3001\u76ee\u5f55\u3001\u7ae0\u8282\u5bfc\u822a\u3001\u4e2d\u6587\u6392\u7248\u548c\u9605\u8bfb\u5668\u754c\u9762\u6d4b\u8bd5\u5236\u4f5c\u7684\u6837\u672c\u3002\u539f\u8457\u300aAlice's Adventures in Wonderland\u300b\u5df2\u8fdb\u5165\u516c\u6709\u9886\u57df\uff1b\u672c\u6587\u4ef6\u4e2d\u7684\u4e2d\u6587\u6587\u5b57\u4e3a\u6d4b\u8bd5\u7528\u9014\u91cd\u65b0\u8868\u8ff0\uff0c\u5e76\u975e\u8f6c\u8f7d\u4efb\u4f55\u73b0\u884c\u5546\u4e1a\u4e2d\u6587\u7248\u3002", "\u6587\u4ef6\u5305\u542b\u5c01\u9762\u3001\u5143\u6570\u636e\u3001\u5341\u4e8c\u7ae0\u76ee\u5f55\u3001\u4e2d\u6587\u6b63\u6587\u3001\u82f1\u6587\u526f\u6807\u9898\u53ca\u57fa\u672c CSS\uff0c\u53ef\u7528\u4e8e\u68c0\u67e5\u4e66\u5e93\u7f29\u7565\u56fe\u3001\u6807\u9898\u622a\u65ad\u3001\u7ae0\u8282\u5217\u8868\u3001\u5b57\u4f53\u56de\u9000\u3001\u6bb5\u843d\u95f4\u8ddd\u3001\u6eda\u52a8\u9605\u8bfb\u548c\u79fb\u52a8\u7aef\u663e\u793a\u3002"]}