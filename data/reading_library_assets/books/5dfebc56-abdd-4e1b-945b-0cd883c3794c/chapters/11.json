{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u5341\u4e00\u7ae0 \u8c01\u5077\u4e86\u9985\u997c"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u6cd5\u5ead\u91cc\uff0c\u7ea2\u5fc3\u56fd\u738b\u5750\u5728\u5ba1\u5224\u5e2d\u4e0a\uff0c\u738b\u540e\u5750\u5728\u4ed6\u65c1\u8fb9\u3002\u7ea2\u5fc3\u6b66\u58eb\u88ab\u6307\u63a7\u5077\u8d70\u4e86\u738b\u540e\u70e4\u7684\u9985\u997c\u3002"}, {"type": "paragraph", "text": "\u966a\u5ba1\u5458\u4eec\u5fd9\u7740\u5728\u77f3\u677f\u4e0a\u8bb0\u7b14\u8bb0\uff0c\u53ef\u4ed6\u4eec\u4f3c\u4e4e\u8fde\u81ea\u5df1\u7684\u540d\u5b57\u90fd\u62c5\u5fc3\u5fd8\u8bb0\u3002\u8bc1\u4eba\u4e00\u4e2a\u63a5\u4e00\u4e2a\u88ab\u53eb\u4e0a\u6765\uff0c\u8bc1\u8bcd\u5374\u8d8a\u6765\u8d8a\u79bb\u9898\u3002"}, {"type": "paragraph", "text": "\u5e3d\u5320\u4e5f\u88ab\u53eb\u6765\u4f5c\u8bc1\u3002\u4ed6\u7d27\u5f20\u5f97\u8bed\u65e0\u4f26\u6b21\uff0c\u624b\u91cc\u8fd8\u7aef\u7740\u6ca1\u5403\u5b8c\u7684\u8336\u70b9\u3002"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u5750\u5728\u65c1\u8fb9\u89c2\u5bdf\u8fd9\u4e00\u5207\u3002\u968f\u7740\u8eab\u4f53\u6162\u6162\u53d8\u5927\uff0c\u5979\u5bf9\u8fd9\u573a\u5ba1\u5224\u4e5f\u8d8a\u6765\u8d8a\u4e0d\u8010\u70e6\u3002"}], "paragraphs": ["\u6cd5\u5ead\u91cc\uff0c\u7ea2\u5fc3\u56fd\u738b\u5750\u5728\u5ba1\u5224\u5e2d\u4e0a\uff0c\u738b\u540e\u5750\u5728\u4ed6\u65c1\u8fb9\u3002\u7ea2\u5fc3\u6b66\u58eb\u88ab\u6307\u63a7\u5077\u8d70\u4e86\u738b\u540e\u70e4\u7684\u9985\u997c\u3002", "\u966a\u5ba1\u5458\u4eec\u5fd9\u7740\u5728\u77f3\u677f\u4e0a\u8bb0\u7b14\u8bb0\uff0c\u53ef\u4ed6\u4eec\u4f3c\u4e4e\u8fde\u81ea\u5df1\u7684\u540d\u5b57\u90fd\u62c5\u5fc3\u5fd8\u8bb0\u3002\u8bc1\u4eba\u4e00\u4e2a\u63a5\u4e00\u4e2a\u88ab\u53eb\u4e0a\u6765\uff0c\u8bc1\u8bcd\u5374\u8d8a\u6765\u8d8a\u79bb\u9898\u3002", "\u5e3d\u5320\u4e5f\u88ab\u53eb\u6765\u4f5c\u8bc1\u3002\u4ed6\u7d27\u5f20\u5f97\u8bed\u65e0\u4f26\u6b21\uff0c\u624b\u91cc\u8fd8\u7aef\u7740\u6ca1\u5403\u5b8c\u7684\u8336\u70b9\u3002", "\u7231\u4e3d\u4e1d\u5750\u5728\u65c1\u8fb9\u89c2\u5bdf\u8fd9\u4e00\u5207\u3002\u968f\u7740\u8eab\u4f53\u6162\u6162\u53d8\u5927\uff0c\u5979\u5bf9\u8fd9\u573a\u5ba1\u5224\u4e5f\u8d8a\u6765\u8d8a\u4e0d\u8010\u70e6\u3002"]}