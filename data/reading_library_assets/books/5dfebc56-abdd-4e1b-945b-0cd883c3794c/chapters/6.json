{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u516d\u7ae0 \u732a\u4e0e\u80e1\u6912"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u6765\u5230\u4e00\u680b\u5c0f\u623f\u5b50\u524d\uff0c\u5c4b\u91cc\u5145\u6ee1\u80e1\u6912\u5473\uff0c\u6240\u6709\u4eba\u90fd\u5728\u6253\u55b7\u568f\u3002\u53a8\u5a18\u4e0d\u505c\u5730\u628a\u9505\u7897\u74e2\u76c6\u5f80\u56db\u5904\u6254\uff0c\u516c\u7235\u592b\u4eba\u6000\u91cc\u62b1\u7740\u4e00\u4e2a\u4e0d\u505c\u5c16\u53eb\u7684\u5a74\u513f\u3002"}, {"type": "paragraph", "text": "\u573a\u9762\u6df7\u4e71\u5f97\u4e0d\u50cf\u4e00\u4e2a\u6b63\u5e38\u7684\u5bb6\u3002\u7231\u4e3d\u4e1d\u63a5\u8fc7\u5a74\u513f\u79bb\u5f00\u540e\uff0c\u60ca\u8bb6\u5730\u53d1\u73b0\u5b83\u8d8a\u6765\u8d8a\u50cf\u4e00\u53ea\u5c0f\u732a\u3002"}, {"type": "paragraph", "text": "\u6811\u6797\u91cc\uff0c\u5979\u53c8\u9047\u89c1\u4e00\u53ea\u67f4\u90e1\u732b\u3002\u732b\u7684\u7b11\u5bb9\u6bd4\u8eab\u4f53\u505c\u7559\u5f97\u66f4\u4e45\uff0c\u751a\u81f3\u5728\u8eab\u4f53\u6d88\u5931\u540e\uff0c\u534a\u7a7a\u4e2d\u8fd8\u5269\u4e0b\u4e00\u5f20\u7b11\u8138\u3002"}, {"type": "paragraph", "text": "\u67f4\u90e1\u732b\u544a\u8bc9\u5979\uff0c\u9644\u8fd1\u4f4f\u7740\u4e09\u6708\u5154\u548c\u5e3d\u5320\uff0c\u800c\u4e14\u8fd9\u91cc\u7684\u4eba\u591a\u5c11\u90fd\u6709\u70b9\u75af\u72c2\u3002"}], "paragraphs": ["\u7231\u4e3d\u4e1d\u6765\u5230\u4e00\u680b\u5c0f\u623f\u5b50\u524d\uff0c\u5c4b\u91cc\u5145\u6ee1\u80e1\u6912\u5473\uff0c\u6240\u6709\u4eba\u90fd\u5728\u6253\u55b7\u568f\u3002\u53a8\u5a18\u4e0d\u505c\u5730\u628a\u9505\u7897\u74e2\u76c6\u5f80\u56db\u5904\u6254\uff0c\u516c\u7235\u592b\u4eba\u6000\u91cc\u62b1\u7740\u4e00\u4e2a\u4e0d\u505c\u5c16\u53eb\u7684\u5a74\u513f\u3002", "\u573a\u9762\u6df7\u4e71\u5f97\u4e0d\u50cf\u4e00\u4e2a\u6b63\u5e38\u7684\u5bb6\u3002\u7231\u4e3d\u4e1d\u63a5\u8fc7\u5a74\u513f\u79bb\u5f00\u540e\uff0c\u60ca\u8bb6\u5730\u53d1\u73b0\u5b83\u8d8a\u6765\u8d8a\u50cf\u4e00\u53ea\u5c0f\u732a\u3002", "\u6811\u6797\u91cc\uff0c\u5979\u53c8\u9047\u89c1\u4e00\u53ea\u67f4\u90e1\u732b\u3002\u732b\u7684\u7b11\u5bb9\u6bd4\u8eab\u4f53\u505c\u7559\u5f97\u66f4\u4e45\uff0c\u751a\u81f3\u5728\u8eab\u4f53\u6d88\u5931\u540e\uff0c\u534a\u7a7a\u4e2d\u8fd8\u5269\u4e0b\u4e00\u5f20\u7b11\u8138\u3002", "\u67f4\u90e1\u732b\u544a\u8bc9\u5979\uff0c\u9644\u8fd1\u4f4f\u7740\u4e09\u6708\u5154\u548c\u5e3d\u5320\uff0c\u800c\u4e14\u8fd9\u91cc\u7684\u4eba\u591a\u5c11\u90fd\u6709\u70b9\u75af\u72c2\u3002"]}