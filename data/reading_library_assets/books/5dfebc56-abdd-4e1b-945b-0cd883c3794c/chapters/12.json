{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u5341\u4e8c\u7ae0 \u7231\u4e3d\u4e1d\u7684\u8bc1\u8bcd"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u6700\u540e\uff0c\u7231\u4e3d\u4e1d\u81ea\u5df1\u88ab\u53eb\u5230\u8bc1\u4eba\u5e2d\u3002\u56fd\u738b\u8bd5\u56fe\u5f15\u7528\u4e00\u4e9b\u6839\u672c\u8bf4\u4e0d\u6e05\u695a\u7684\u89c4\u5219\uff0c\u738b\u540e\u5219\u7167\u65e7\u60f3\u5148\u5224\u5211\u3001\u540e\u5ba1\u7406\u3002"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u7ec8\u4e8e\u5fcd\u4e0d\u4f4f\u6307\u51fa\uff1a\u8fd9\u4e00\u5207\u5b8c\u5168\u6ca1\u6709\u9053\u7406\u3002\u5979\u8d8a\u8bf4\u8d8a\u6709\u5e95\u6c14\uff0c\u800c\u5468\u56f4\u90a3\u4e9b\u6c14\u52bf\u6c79\u6c79\u7684\u4eba\u7a81\u7136\u663e\u5f97\u4e0d\u8fc7\u662f\u4e00\u526f\u6251\u514b\u724c\u3002"}, {"type": "paragraph", "text": "\u6251\u514b\u724c\u6f2b\u5929\u98de\u8d77\uff0c\u7231\u4e3d\u4e1d\u62ac\u624b\u60f3\u628a\u5b83\u4eec\u8d76\u5f00\u2014\u2014\u5c31\u5728\u8fd9\u4e00\u523b\uff0c\u5979\u9192\u4e86\u3002"}, {"type": "paragraph", "text": "\u5979\u53d1\u73b0\u81ea\u5df1\u4ecd\u8eba\u5728\u6cb3\u5cb8\u8fb9\uff0c\u5934\u6795\u5728\u59d0\u59d0\u817f\u4e0a\u3002\u521a\u624d\u90a3\u4e2a\u5de8\u5927\u3001\u8352\u5510\u3001\u70ed\u95f9\u7684\u4e16\u754c\uff0c\u539f\u6765\u53ea\u662f\u4e00\u573a\u68a6\u3002"}], "paragraphs": ["\u6700\u540e\uff0c\u7231\u4e3d\u4e1d\u81ea\u5df1\u88ab\u53eb\u5230\u8bc1\u4eba\u5e2d\u3002\u56fd\u738b\u8bd5\u56fe\u5f15\u7528\u4e00\u4e9b\u6839\u672c\u8bf4\u4e0d\u6e05\u695a\u7684\u89c4\u5219\uff0c\u738b\u540e\u5219\u7167\u65e7\u60f3\u5148\u5224\u5211\u3001\u540e\u5ba1\u7406\u3002", "\u7231\u4e3d\u4e1d\u7ec8\u4e8e\u5fcd\u4e0d\u4f4f\u6307\u51fa\uff1a\u8fd9\u4e00\u5207\u5b8c\u5168\u6ca1\u6709\u9053\u7406\u3002\u5979\u8d8a\u8bf4\u8d8a\u6709\u5e95\u6c14\uff0c\u800c\u5468\u56f4\u90a3\u4e9b\u6c14\u52bf\u6c79\u6c79\u7684\u4eba\u7a81\u7136\u663e\u5f97\u4e0d\u8fc7\u662f\u4e00\u526f\u6251\u514b\u724c\u3002", "\u6251\u514b\u724c\u6f2b\u5929\u98de\u8d77\uff0c\u7231\u4e3d\u4e1d\u62ac\u624b\u60f3\u628a\u5b83\u4eec\u8d76\u5f00\u2014\u2014\u5c31\u5728\u8fd9\u4e00\u523b\uff0c\u5979\u9192\u4e86\u3002", "\u5979\u53d1\u73b0\u81ea\u5df1\u4ecd\u8eba\u5728\u6cb3\u5cb8\u8fb9\uff0c\u5934\u6795\u5728\u59d0\u59d0\u817f\u4e0a\u3002\u521a\u624d\u90a3\u4e2a\u5de8\u5927\u3001\u8352\u5510\u3001\u70ed\u95f9\u7684\u4e16\u754c\uff0c\u539f\u6765\u53ea\u662f\u4e00\u573a\u68a6\u3002"]}