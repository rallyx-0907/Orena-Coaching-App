{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u56db\u7ae0 \u767d\u5154\u7684\u5c0f\u5dee\u4e8b"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u767d\u5154\u53c8\u51fa\u73b0\u4e86\uff0c\u5374\u628a\u7231\u4e3d\u4e1d\u9519\u8ba4\u6210\u81ea\u5df1\u7684\u5973\u4ec6\uff0c\u6025\u6025\u5fd9\u5fd9\u53eb\u5979\u56de\u5c4b\u53bb\u53d6\u624b\u5957\u548c\u6247\u5b50\u3002"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u8d70\u8fdb\u767d\u5154\u7684\u623f\u5b50\uff0c\u5728\u684c\u4e0a\u53c8\u53d1\u73b0\u4e00\u74f6\u996e\u6599\u3002\u5979\u660e\u77e5\u9053\u8fd9\u91cc\u7684\u98df\u7269\u548c\u996e\u6599\u603b\u4f1a\u5e26\u6765\u9ebb\u70e6\uff0c\u8fd8\u662f\u5fcd\u4e0d\u4f4f\u5c1d\u4e86\u4e00\u53e3\u3002"}, {"type": "paragraph", "text": "\u8fd9\u4e00\u6b21\uff0c\u5979\u8d8a\u957f\u8d8a\u5927\uff0c\u6700\u540e\u51e0\u4e4e\u585e\u6ee1\u4e86\u6574\u95f4\u5c4b\u5b50\u3002\u4e00\u53ea\u624b\u4f38\u51fa\u7a97\u5916\uff0c\u4e00\u53ea\u811a\u5361\u5728\u70df\u56f1\u9644\u8fd1\uff0c\u767d\u5154\u548c\u5916\u9762\u7684\u52a8\u7269\u4eec\u5168\u90fd\u614c\u4e86\u3002"}, {"type": "paragraph", "text": "\u4ed6\u4eec\u60f3\u51fa\u5404\u79cd\u529e\u6cd5\u628a\u8fd9\u4e2a\u201c\u4e0d\u660e\u751f\u7269\u201d\u8d76\u51fa\u53bb\uff0c\u800c\u7231\u4e3d\u4e1d\u53ea\u60f3\u6062\u590d\u6b63\u5e38\u5927\u5c0f\uff0c\u8d76\u5feb\u79bb\u5f00\u8fd9\u680b\u8d8a\u6765\u8d8a\u62e5\u6324\u7684\u5c0f\u623f\u5b50\u3002"}], "paragraphs": ["\u767d\u5154\u53c8\u51fa\u73b0\u4e86\uff0c\u5374\u628a\u7231\u4e3d\u4e1d\u9519\u8ba4\u6210\u81ea\u5df1\u7684\u5973\u4ec6\uff0c\u6025\u6025\u5fd9\u5fd9\u53eb\u5979\u56de\u5c4b\u53bb\u53d6\u624b\u5957\u548c\u6247\u5b50\u3002", "\u7231\u4e3d\u4e1d\u8d70\u8fdb\u767d\u5154\u7684\u623f\u5b50\uff0c\u5728\u684c\u4e0a\u53c8\u53d1\u73b0\u4e00\u74f6\u996e\u6599\u3002\u5979\u660e\u77e5\u9053\u8fd9\u91cc\u7684\u98df\u7269\u548c\u996e\u6599\u603b\u4f1a\u5e26\u6765\u9ebb\u70e6\uff0c\u8fd8\u662f\u5fcd\u4e0d\u4f4f\u5c1d\u4e86\u4e00\u53e3\u3002", "\u8fd9\u4e00\u6b21\uff0c\u5979\u8d8a\u957f\u8d8a\u5927\uff0c\u6700\u540e\u51e0\u4e4e\u585e\u6ee1\u4e86\u6574\u95f4\u5c4b\u5b50\u3002\u4e00\u53ea\u624b\u4f38\u51fa\u7a97\u5916\uff0c\u4e00\u53ea\u811a\u5361\u5728\u70df\u56f1\u9644\u8fd1\uff0c\u767d\u5154\u548c\u5916\u9762\u7684\u52a8\u7269\u4eec\u5168\u90fd\u614c\u4e86\u3002", "\u4ed6\u4eec\u60f3\u51fa\u5404\u79cd\u529e\u6cd5\u628a\u8fd9\u4e2a\u201c\u4e0d\u660e\u751f\u7269\u201d\u8d76\u51fa\u53bb\uff0c\u800c\u7231\u4e3d\u4e1d\u53ea\u60f3\u6062\u590d\u6b63\u5e38\u5927\u5c0f\uff0c\u8d76\u5feb\u79bb\u5f00\u8fd9\u680b\u8d8a\u6765\u8d8a\u62e5\u6324\u7684\u5c0f\u623f\u5b50\u3002"]}