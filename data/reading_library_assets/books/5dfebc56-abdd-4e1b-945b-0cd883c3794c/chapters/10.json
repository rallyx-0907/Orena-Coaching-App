{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u5341\u7ae0 \u9f99\u867e\u56db\u7ec4\u821e"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u5047\u6d77\u9f9f\u548c\u72ee\u9e6b\u5f00\u59cb\u793a\u8303\u4e00\u79cd\u5947\u602a\u7684\u821e\u8e48\u3002\u4ed6\u4eec\u63cf\u8ff0\u6d77\u91cc\u7684\u52a8\u7269\u5982\u4f55\u6392\u6210\u961f\uff0c\u7275\u7740\u9f99\u867e\uff0c\u5411\u524d\u3001\u5411\u540e\uff0c\u518d\u628a\u9f99\u867e\u8fdc\u8fdc\u629b\u51fa\u53bb\u3002"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u52aa\u529b\u8ddf\u4e0a\u4ed6\u4eec\u7684\u89e3\u91ca\uff0c\u4f46\u6b65\u9aa4\u8d8a\u6765\u8d8a\u590d\u6742\u3002\u5979\u89c9\u5f97\u8fd9\u65e2\u50cf\u821e\u8e48\uff0c\u53c8\u50cf\u4e00\u573a\u6ca1\u6709\u4eba\u80fd\u771f\u6b63\u8bb0\u4f4f\u89c4\u5219\u7684\u6e38\u620f\u3002"}, {"type": "paragraph", "text": "\u968f\u540e\uff0c\u4ed6\u4eec\u8f6e\u6d41\u5531\u6b4c\u548c\u8bb2\u6545\u4e8b\u3002\u8bb8\u591a\u719f\u6089\u7684\u7ae5\u8c23\u5728\u8fd9\u91cc\u90fd\u53d8\u4e86\u6837\uff0c\u542c\u8d77\u6765\u65e2\u964c\u751f\u53c8\u4f3c\u66fe\u76f8\u8bc6\u3002"}, {"type": "paragraph", "text": "\u6b63\u5f53\u8868\u6f14\u7ee7\u7eed\u65f6\uff0c\u8fdc\u5904\u7a81\u7136\u4f20\u6765\u58f0\u97f3\uff1a\u5ba1\u5224\u8981\u5f00\u59cb\u4e86\u3002\u72ee\u9e6b\u7acb\u523b\u62c9\u7740\u7231\u4e3d\u4e1d\u8dd1\u5411\u6cd5\u5ead\u3002"}], "paragraphs": ["\u5047\u6d77\u9f9f\u548c\u72ee\u9e6b\u5f00\u59cb\u793a\u8303\u4e00\u79cd\u5947\u602a\u7684\u821e\u8e48\u3002\u4ed6\u4eec\u63cf\u8ff0\u6d77\u91cc\u7684\u52a8\u7269\u5982\u4f55\u6392\u6210\u961f\uff0c\u7275\u7740\u9f99\u867e\uff0c\u5411\u524d\u3001\u5411\u540e\uff0c\u518d\u628a\u9f99\u867e\u8fdc\u8fdc\u629b\u51fa\u53bb\u3002", "\u7231\u4e3d\u4e1d\u52aa\u529b\u8ddf\u4e0a\u4ed6\u4eec\u7684\u89e3\u91ca\uff0c\u4f46\u6b65\u9aa4\u8d8a\u6765\u8d8a\u590d\u6742\u3002\u5979\u89c9\u5f97\u8fd9\u65e2\u50cf\u821e\u8e48\uff0c\u53c8\u50cf\u4e00\u573a\u6ca1\u6709\u4eba\u80fd\u771f\u6b63\u8bb0\u4f4f\u89c4\u5219\u7684\u6e38\u620f\u3002", "\u968f\u540e\uff0c\u4ed6\u4eec\u8f6e\u6d41\u5531\u6b4c\u548c\u8bb2\u6545\u4e8b\u3002\u8bb8\u591a\u719f\u6089\u7684\u7ae5\u8c23\u5728\u8fd9\u91cc\u90fd\u53d8\u4e86\u6837\uff0c\u542c\u8d77\u6765\u65e2\u964c\u751f\u53c8\u4f3c\u66fe\u76f8\u8bc6\u3002", "\u6b63\u5f53\u8868\u6f14\u7ee7\u7eed\u65f6\uff0c\u8fdc\u5904\u7a81\u7136\u4f20\u6765\u58f0\u97f3\uff1a\u5ba1\u5224\u8981\u5f00\u59cb\u4e86\u3002\u72ee\u9e6b\u7acb\u523b\u62c9\u7740\u7231\u4e3d\u4e1d\u8dd1\u5411\u6cd5\u5ead\u3002"]}