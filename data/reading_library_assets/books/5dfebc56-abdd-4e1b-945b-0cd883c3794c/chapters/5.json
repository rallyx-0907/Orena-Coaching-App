{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u4e94\u7ae0 \u6bdb\u6bdb\u866b\u7684\u5efa\u8bae"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u68ee\u6797\u91cc\uff0c\u4e00\u53ea\u84dd\u8272\u6bdb\u6bdb\u866b\u5750\u5728\u8611\u83c7\u4e0a\uff0c\u6162\u60a0\u60a0\u5730\u62bd\u7740\u6c34\u70df\u3002\u5b83\u770b\u7740\u7231\u4e3d\u4e1d\uff0c\u95ee\u4e86\u4e00\u4e2a\u7b80\u5355\u5374\u8ba9\u5979\u96be\u4ee5\u56de\u7b54\u7684\u95ee\u9898\uff1a\u201c\u4f60\u662f\u8c01\uff1f\u201d"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u89e3\u91ca\u8bf4\uff0c\u81ea\u5df1\u4eca\u5929\u5df2\u7ecf\u53d8\u5927\u53d8\u5c0f\u5f88\u591a\u6b21\uff0c\u6240\u4ee5\u8fde\u81ea\u5df1\u662f\u8c01\u90fd\u5feb\u5f04\u4e0d\u6e05\u695a\u4e86\u3002"}, {"type": "paragraph", "text": "\u6bdb\u6bdb\u866b\u5e76\u6ca1\u6709\u8868\u73b0\u51fa\u591a\u5c11\u540c\u60c5\uff0c\u53ea\u544a\u8bc9\u5979\uff1a\u8611\u83c7\u7684\u4e00\u8fb9\u4f1a\u8ba9\u5979\u957f\u9ad8\uff0c\u53e6\u4e00\u8fb9\u4f1a\u8ba9\u5979\u53d8\u77ee\u3002"}, {"type": "paragraph", "text": "\u95ee\u9898\u662f\uff0c\u5706\u5706\u7684\u8611\u83c7\u5230\u5e95\u54ea\u8fb9\u7b97\u201c\u4e00\u8fb9\u201d\uff0c\u54ea\u8fb9\u53c8\u7b97\u201c\u53e6\u4e00\u8fb9\u201d\uff1f\u7231\u4e3d\u4e1d\u53ea\u597d\u63b0\u4e0b\u4e24\u5757\uff0c\u5c0f\u5fc3\u5730\u8bd5\u9a8c\u3002"}], "paragraphs": ["\u68ee\u6797\u91cc\uff0c\u4e00\u53ea\u84dd\u8272\u6bdb\u6bdb\u866b\u5750\u5728\u8611\u83c7\u4e0a\uff0c\u6162\u60a0\u60a0\u5730\u62bd\u7740\u6c34\u70df\u3002\u5b83\u770b\u7740\u7231\u4e3d\u4e1d\uff0c\u95ee\u4e86\u4e00\u4e2a\u7b80\u5355\u5374\u8ba9\u5979\u96be\u4ee5\u56de\u7b54\u7684\u95ee\u9898\uff1a\u201c\u4f60\u662f\u8c01\uff1f\u201d", "\u7231\u4e3d\u4e1d\u89e3\u91ca\u8bf4\uff0c\u81ea\u5df1\u4eca\u5929\u5df2\u7ecf\u53d8\u5927\u53d8\u5c0f\u5f88\u591a\u6b21\uff0c\u6240\u4ee5\u8fde\u81ea\u5df1\u662f\u8c01\u90fd\u5feb\u5f04\u4e0d\u6e05\u695a\u4e86\u3002", "\u6bdb\u6bdb\u866b\u5e76\u6ca1\u6709\u8868\u73b0\u51fa\u591a\u5c11\u540c\u60c5\uff0c\u53ea\u544a\u8bc9\u5979\uff1a\u8611\u83c7\u7684\u4e00\u8fb9\u4f1a\u8ba9\u5979\u957f\u9ad8\uff0c\u53e6\u4e00\u8fb9\u4f1a\u8ba9\u5979\u53d8\u77ee\u3002", "\u95ee\u9898\u662f\uff0c\u5706\u5706\u7684\u8611\u83c7\u5230\u5e95\u54ea\u8fb9\u7b97\u201c\u4e00\u8fb9\u201d\uff0c\u54ea\u8fb9\u53c8\u7b97\u201c\u53e6\u4e00\u8fb9\u201d\uff1f\u7231\u4e3d\u4e1d\u53ea\u597d\u63b0\u4e0b\u4e24\u5757\uff0c\u5c0f\u5fc3\u5730\u8bd5\u9a8c\u3002"]}