{"format": 2, "blocks": [{"type": "heading", "level": 1, "text": "\u7b2c\u4e5d\u7ae0 \u5047\u6d77\u9f9f\u7684\u6545\u4e8b"}, {"type": "heading", "level": 2, "text": "\u7231\u4e3d\u4e1d\u68a6\u6e38\u4ed9\u5883"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u88ab\u5e26\u53bb\u89c1\u5047\u6d77\u9f9f\u3002\u5b83\u603b\u662f\u4e00\u526f\u60b2\u4f24\u7684\u6837\u5b50\uff0c\u4eff\u4f5b\u968f\u65f6\u90fd\u8981\u53f9\u6c14\u3002"}, {"type": "paragraph", "text": "\u5047\u6d77\u9f9f\u56de\u5fc6\u81ea\u5df1\u5728\u6d77\u5e95\u4e0a\u5b66\u7684\u65e5\u5b50\u3002\u8bfe\u7a0b\u540d\u79f0\u542c\u8d77\u6765\u548c\u73b0\u5b9e\u4e2d\u7684\u5b66\u6821\u5f88\u50cf\uff0c\u5374\u603b\u88ab\u6545\u610f\u626d\u6210\u53e6\u4e00\u79cd\u6ed1\u7a3d\u7684\u610f\u601d\u3002"}, {"type": "paragraph", "text": "\u72ee\u9e6b\u5728\u65c1\u8fb9\u50ac\u4fc3\u5b83\u522b\u54ed\u592a\u4e45\uff0c\u8d76\u5feb\u8bb2\u4e9b\u6709\u8da3\u7684\u4e8b\u60c5\u3002\u4e8e\u662f\u4ed6\u4eec\u8c08\u8d77\u821e\u8e48\u3001\u8bfe\u7a0b\u4ee5\u53ca\u6d77\u91cc\u7684\u751f\u6d3b\u3002"}, {"type": "paragraph", "text": "\u7231\u4e3d\u4e1d\u8d8a\u6765\u8d8a\u4e60\u60ef\u8fd9\u91cc\u7684\u8352\u8bde\uff1a\u53ea\u8981\u4e0d\u671f\u5f85\u4e8b\u60c5\u5408\u4e4e\u5e38\u7406\uff0c\u53cd\u800c\u6bd4\u8f83\u5bb9\u6613\u7406\u89e3\u773c\u524d\u53d1\u751f\u7684\u4e00\u5207\u3002"}], "paragraphs": ["\u7231\u4e3d\u4e1d\u88ab\u5e26\u53bb\u89c1\u5047\u6d77\u9f9f\u3002\u5b83\u603b\u662f\u4e00\u526f\u60b2\u4f24\u7684\u6837\u5b50\uff0c\u4eff\u4f5b\u968f\u65f6\u90fd\u8981\u53f9\u6c14\u3002", "\u5047\u6d77\u9f9f\u56de\u5fc6\u81ea\u5df1\u5728\u6d77\u5e95\u4e0a\u5b66\u7684\u65e5\u5b50\u3002\u8bfe\u7a0b\u540d\u79f0\u542c\u8d77\u6765\u548c\u73b0\u5b9e\u4e2d\u7684\u5b66\u6821\u5f88\u50cf\uff0c\u5374\u603b\u88ab\u6545\u610f\u626d\u6210\u53e6\u4e00\u79cd\u6ed1\u7a3d\u7684\u610f\u601d\u3002", "\u72ee\u9e6b\u5728\u65c1\u8fb9\u50ac\u4fc3\u5b83\u522b\u54ed\u592a\u4e45\uff0c\u8d76\u5feb\u8bb2\u4e9b\u6709\u8da3\u7684\u4e8b\u60c5\u3002\u4e8e\u662f\u4ed6\u4eec\u8c08\u8d77\u821e\u8e48\u3001\u8bfe\u7a0b\u4ee5\u53ca\u6d77\u91cc\u7684\u751f\u6d3b\u3002", "\u7231\u4e3d\u4e1d\u8d8a\u6765\u8d8a\u4e60\u60ef\u8fd9\u91cc\u7684\u8352\u8bde\uff1a\u53ea\u8981\u4e0d\u671f\u5f85\u4e8b\u60c5\u5408\u4e4e\u5e38\u7406\uff0c\u53cd\u800c\u6bd4\u8f83\u5bb9\u6613\u7406\u89e3\u773c\u524d\u53d1\u751f\u7684\u4e00\u5207\u3002"]}